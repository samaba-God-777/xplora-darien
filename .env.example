# Copiar a .env y completar. Nunca subir .env al repositorio.

# --- PostgreSQL (docker compose)
POSTGRES_USER=xplora
POSTGRES_PASSWORD=cambie-esta-contraseña

# --- API Rust
# Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# --- Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Archivos propios (subidas, videos generados, pósters) servidos por la API
PUBLIC_FILES_URL=http://localhost:8080/files

# --- Higgsfield (XPLORA AI Video Studio). Solo los lee el backend Rust; nunca el navegador.
# Crear en https://console.higgsfield.ai  (Authorization: Key <id>:<secret>)
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# --- Correo (avisos de reservas). Sin valor = los avisos quedan en cola sin enviarse.
# Producción: smtps://usuario:clave@smtp.tu-proveedor.com:465   ·   Desarrollo: file://../storage/mail (escribe .eml)
MAIL_URL=
MAIL_FROM=XPLORA DARIÉN <reservas@tu-dominio.com>
SITE_URL=http://localhost:3000
